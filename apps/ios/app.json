{
  "expo": {
    "name": "فرصة وتمكين",
    "slug": "forsa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "forsa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sa.forsh.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "نستخدم Face ID لحماية المستندات السرية بعد توقيع اتفاقية عدم الإفصاح. Face ID protects confidential documents you can open after signing an NDA.",
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17234F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم Face ID لحماية المستندات السرية بعد توقيع اتفاقية عدم الإفصاح. Face ID protects confidential documents you can open after signing an NDA."
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
